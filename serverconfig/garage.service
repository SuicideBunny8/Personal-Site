[Unit]
Description=Garage S3 Data Store
After=network-online.target
Wants=network-online.target

[Service]
Environment='GARAGE_CONFIG_FILE=/etc/garage.toml' 'RUST_LOG=garage=info' 'RUST_BACKTRACE=1'
ExecStart=/usr/local/bin/garage server
User=garage
Group=garage
PrivateTmp=yes
RemoveIPC=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/garage/meta /mnt/[second-drive]/garage/data
ProtectHome=true
NoNewPrivileges=true
LimitNOFILE=42000
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
